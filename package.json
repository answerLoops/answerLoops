{
  "name": "community-platform",
  "version": "0.6.5",
  "private": true,
  "scripts": {
    "prepare": "test -f scripts/install-hooks.sh && sh scripts/install-hooks.sh || true",
    "dev": "next dev --webpack",
    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "bot": "tsx watch bot/index.ts",
    "bot:start": "tsx bot/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm bot\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e:ui": "playwright test --ui",
    "test:server": "next start -p 3100",
    "docker:preview": "docker compose -f docker-compose.prod.yml down && docker compose -f docker-compose.prod.yml up -d --build app",
    "docs:generate-api": "node scripts/generate-api-reference.mjs",
    "llms:sync": "node scripts/sync-llms-txt.mjs",
    "llms:check": "node scripts/sync-llms-txt.mjs --check",
    "load-test": "tsx scripts/load-test-mcp-agent.ts",
    "docs:seed": "tsx scripts/docs-demo/seed.ts",
    "docs:session": "tsx scripts/docs-demo/session.ts",
    "docs:shots": "tsx scripts/docs-demo/capture.ts",
    "lint:fix": "oxlint --fix",
    "verify:stripe-prices": "tsx scripts/verify-stripe-prices.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.94",
    "@ai-sdk/groq": "^4.0.60",
    "@ai-sdk/mistral": "^4.0.63",
    "@ai-sdk/openai": "^4.0.92",
    "@copilotkit/react-core": "1.79.0",
    "@copilotkit/runtime": "1.79.0",
    "@mastra/core": "^1.75.0",
    "@mastra/memory": "^1.36.0",
    "@mastra/pg": "^1.30.0",
    "@mendable/firecrawl-js": "^4.46.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@sentry/nextjs": "^11.7.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "ai": "^7.0.138",
    "csv-parse": "^7.0.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "fumadocs-core": "^16.17.2",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-openapi": "^11.2.2",
    "fumadocs-ui": "^16.17.2",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.14.6",
    "oxlint": "1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
