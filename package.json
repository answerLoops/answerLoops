{
  "name": "community-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "test -f scripts/install-hooks.sh && sh scripts/install-hooks.sh || true",
    "dev": "next dev",
    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "bot": "tsx watch bot/index.ts",
    "bot:start": "tsx bot/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm bot\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e:ui": "playwright test --ui",
    "test:server": "next start -p 3100",
    "docker:preview": "docker compose -f docker-compose.prod.yml down && docker compose -f docker-compose.prod.yml up -d --build app",
    "docs:generate-api": "node scripts/generate-api-reference.mjs",
    "llms:sync": "node scripts/sync-llms-txt.mjs",
    "llms:check": "node scripts/sync-llms-txt.mjs --check",
    "load-test": "tsx scripts/load-test-mcp-agent.ts",
    "lint:fix": "oxlint --fix",
    "verify:stripe-prices": "tsx scripts/verify-stripe-prices.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/groq": "^3.0.42",
    "@ai-sdk/mistral": "^3.0.40",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/react": "^3.0.209",
    "@copilotkit/react-core": "1.70.1",
    "@copilotkit/runtime": "1.70.1",
    "@mastra/core": "^1.55.0",
    "@mastra/memory": "^1.24.0",
    "@mastra/pg": "^1.18.1",
    "@mendable/firecrawl-js": "^4.28.1",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "ai": "^6.0.153",
    "csv-parse": "^7.0.0",
    "discord.js": "^14.26.2",
    "drizzle-orm": "^0.45.2",
    "fumadocs-core": "^16.11.5",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-openapi": "^11.2.2",
    "fumadocs-ui": "^16.11.5",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "stripe": "^22.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "oxlint": "1.74.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
