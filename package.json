{
  "name": "community-platform",
  "version": "0.6.8",
  "private": true,
  "scripts": {
    "prepare": "test -f scripts/install-hooks.sh && sh scripts/install-hooks.sh || true",
    "dev": "next dev --webpack",
    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "bot": "tsx watch bot/index.ts",
    "bot:start": "tsx bot/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm bot\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e:ui": "playwright test --ui",
    "test:server": "next start -p 3100",
    "docker:preview": "docker compose -f docker-compose.prod.yml down && docker compose -f docker-compose.prod.yml up -d --build app",
    "docs:generate-api": "node scripts/generate-api-reference.mjs",
    "llms:sync": "node scripts/sync-llms-txt.mjs",
    "llms:check": "node scripts/sync-llms-txt.mjs --check",
    "changelog:sync": "node scripts/sync-changelog.mjs",
    "changelog:check": "node scripts/sync-changelog.mjs --check",
    "load-test": "tsx scripts/load-test-mcp-agent.ts",
    "support:eval": "tsx scripts/support-eval.ts",
    "support:shadow": "tsx scripts/support-shadow.ts",
    "github:backfill-threads": "tsx scripts/backfill-github-comment-threads.ts",
    "docs:seed": "tsx scripts/docs-demo/seed.ts",
    "docs:session": "tsx scripts/docs-demo/session.ts",
    "demo:open": "tsx scripts/docs-demo/open.ts",
    "docs:shots": "tsx scripts/docs-demo/capture.ts",
    "lint:fix": "oxlint --fix",
    "verify:stripe-prices": "tsx scripts/verify-stripe-prices.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.4",
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/groq": "^4.0.77",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.109",
    "@copilotkit/react-core": "1.84.1",
    "@copilotkit/runtime": "1.84.1",
    "@mastra/core": "^1.82.0",
    "@mastra/memory": "^1.41.0",
    "@mastra/pg": "^1.35.0",
    "@mendable/firecrawl-js": "^4.52.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@sentry/nextjs": "^11.11.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "ai": "^7.0.163",
    "csv-parse": "^7.0.3",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "fumadocs-core": "^16.18.0",
    "fumadocs-mdx": "^15.5.0",
    "fumadocs-openapi": "^12.6.0",
    "fumadocs-ui": "^16.18.0",
    "google-auth-library": "^11.3.3",
    "lucide-react": "^1.69.0",
    "mammoth": "^1.13.0",
    "mermaid": "12.3.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "stripe": "^23.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.47.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "happy-dom": "^21.0.4",
    "oxlint": "1.91.0",
    "railway": "^3.16.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
