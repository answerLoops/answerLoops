{
  "name": "@answerloops/widget",
  "version": "0.1.0",
  "description": "Add the answerLoops chat widget to a React, Next.js or plain JavaScript site. Loads the widget from your answerLoops instance and answers from your published knowledge base.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/answerLoops/answerLoops.git",
    "directory": "packages/widget"
  },
  "homepage": "https://answerloops.com/docs/product/chat-widget",
  "bugs": "https://github.com/answerLoops/answerLoops/issues",
  "keywords": [
    "answerloops",
    "chat-widget",
    "support",
    "knowledge-base",
    "react",
    "nextjs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
