# Copy to .env and fill in what you need. See the self-hosting guide for the
# full walkthrough: https://answerloops.com/docs/quickstart-self-host
# Complete reference for every variable: https://answerloops.com/docs/reference/environment-variables

# Core (required)
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
ENCRYPTION_KEY=

# Auth (required — sign-in is Google-only; there is no GitHub or Discord OAuth provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Bot
BOT_SECRET=
BOT_TARGET_URL=

# Chat widget
NEXT_PUBLIC_DOCS_WIDGET_TOKEN=

# Pooled Postgres providers (Neon -pooler, PgBouncer) — non-pooled connection
# string for LISTEN/NOTIFY. Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=

# Networking (optional)
TRUST_PROXY_HOPS=1
ORIGIN_VERIFY_SECRET=

# Cloud multi-subdomain (optional — most deployments leave both unset)
NEXT_PUBLIC_APP_URL=
AUTH_COOKIE_DOMAIN=


# Discord (optional — ingest channel)
DISCORD_APPLICATION_ID=
DISCORD_CHANNEL_IDS=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_TOKEN=

# Slack (optional — ingest channel)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_POLL_INTERVAL_SECONDS=60
SLACK_SIGNING_SECRET=

# Google Chat (optional — ingest channel)
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=
GOOGLE_CHAT_ENDPOINT_URL=

# Telegram (optional — ingest channel)
TELEGRAM_BOT_TOKEN=

# GitHub App (optional — code-aware AI answers + repo-linked tickets)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Discourse, Circle, and the Notion KB source (optional — ingest channels /
# KB source) need no environment variable at all. Each org connects its own
# forum, community, or workspace in Settings by pasting its own credential,
# stored encrypted (see ENCRYPTION_KEY above). See
# https://answerloops.com/docs/integrations/discourse,
# https://answerloops.com/docs/integrations/circle, and
# https://answerloops.com/docs/integrations/notion

# AI providers (optional — platform-wide fallback; OPENAI_API_KEY is the only
# one used before an org configures its own key in Settings → AI Model)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Firecrawl (optional — URL KB ingest)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=

# Resend (optional — email alerts + email ingest channel)
RESEND_API_KEY=
RESEND_FROM=
RESEND_WAITLIST_FROM=
RESEND_WEBHOOK_SECRET=

# Connect Gmail / Outlook (optional — send-only email integrations)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=

# Web Push (optional — browser push notifications)
VAPID_EMAIL=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Analytics tuning (optional)
ROI_MINUTES_PER_TICKET=
ROI_STAFF_HOURLY_RATE=

# Error tracking (optional — Sentry, https://sentry.io)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
